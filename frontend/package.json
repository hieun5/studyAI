{
  "name": "studyai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vite build --configLoader runner --ssr tests/entries.ts --outDir .ui-test-build && node --test tests/practice.test.mjs tests/results.test.mjs tests/dashboard.test.mjs tests/api.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
