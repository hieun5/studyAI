# Frontend: copy this file to frontend/.env if overriding the API URL.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Backend: set these as PowerShell environment variables before starting Uvicorn.
# Defaults work without configuration; the backend does not auto-load .env files.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=100
MAX_SESSIONS=8
MAX_STORE_BYTES=67108864
SESSION_TTL_SECONDS=1800

# FastAPI reads these Ollama settings from its process environment.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_ATTEMPTS=3
# Set this in the Ollama server terminal, not just the FastAPI terminal.
OLLAMA_NO_CLOUD=1
